<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FocusGuard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Tela de compartilhamento: só o diálogo, por cima do app de origem -->
    <style name="Theme.FocusGuard.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!-- Tema usado ao inflar o overlay a partir do serviço -->
    <style name="Theme.FocusGuard.Overlay" parent="android:Theme.Material.NoActionBar" />
    <!-- Botões de tempo (5 min, 10 min...) da tela "Estou com tempo livre" -->
    <style name="FreeTimeChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">3dp</item>
        <item name="android:backgroundTint">@color/overlay_button_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
